{
    "version": 8,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_CUDA_COMPILER": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.3/bin/nvcc.exe",
                "CUDAToolkit_ROOT": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.3",
                "FFMPEG_ROOT": "C:/Program Files/WinGet/Packages/Gyan.FFmpeg.Shared_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.2-full_build-shared",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/../bin"
            }
        },
        {
            "name": "landscape-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "landscape-release",
            "displayName": "Windows x64 Release",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        {
            "name": "landscape-debug",
            "configurePreset": "landscape-debug",
            "targets": ["landscape"]
        },
        {
            "name": "landscape-release",
            "configurePreset": "landscape-release",
            "targets": ["landscape"]
        }
    ]
}
